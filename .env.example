APP_NAME=punchcard
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=fr
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=fr_FR
APP_TIMEZONE=UTC

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Local Postgres comes from docker-compose.yml (docker compose up -d).
# Use DB_CONNECTION=sqlite if you have no Docker; tests always use in-memory SQLite.
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=punchcard
DB_USERNAME=punchcard
DB_PASSWORD=punchcard

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Mailpit from docker-compose.yml, inbox at http://localhost:8025
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@punchcard.test"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- punchcard domain -------------------------------------------------------
# Tap URLs printed on NFC stampers (SUN / NTAG 424 DNA). See docs/adr/0002.
TAP_URL=http://localhost:8000/t
# Master key used to derive per-tag AES keys. NEVER commit a real value.
# Generate: php -r "echo bin2hex(random_bytes(16)), PHP_EOL;"
NFC_SUN_MASTER_KEY=
NFC_SUN_KEY_VERSION=1

# Stamp anti-fraud defaults (overridable per loyalty card)
STAMP_COOLDOWN_MINUTES=20
STAMP_DAILY_CAP=5

# Apple Wallet (Pass Type ID certificate lives outside the repo)
APPLE_PASS_TYPE_ID=
APPLE_TEAM_ID=
APPLE_PASS_CERT_PATH=
APPLE_PASS_CERT_PASSWORD=
APPLE_WWDR_CERT_PATH=

# Google Wallet
GOOGLE_WALLET_ISSUER_ID=
GOOGLE_WALLET_SERVICE_ACCOUNT_JSON=

# Web push (php artisan webpush:vapid once the package is installed)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Social login (customers)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=

SENTRY_LARAVEL_DSN=
